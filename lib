class MapPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final road = Paint()..color = Colors.white..strokeWidth = 24;
    canvas.drawLine(Offset(0, size.height*.55), Offset(size.width, size.height*.25), road);
    canvas.drawLine(Offset(size.width*.15, 0), Offset(size.width*.75, size.height), road);
    final thin = Paint()..color = const Color(0xFFD5DDE6)..strokeWidth = 2;
    for (double y=70; y<size.height; y+=90) {
      canvas.drawLine(Offset(0,y), Offset(size.width,y+30), thin);
    }
  }
  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

